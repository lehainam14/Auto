<Window x:Class="Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="macro" Width="1360" Height="840"
        MinWidth="980" MinHeight="620"
        Background="{StaticResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="StatusDotIdle" Color="#8F939C" />
    </Window.Resources>
    <DockPanel>
        <!-- ================= TOP BAR ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.BgPanel}"
                BorderBrush="#2F3034" BorderThickness="0,0,0,1" Height="38">
            <DockPanel LastChildFill="True" Margin="10,0,8,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image x:Name="LogoIcon" Width="18" Height="18"
                           VerticalAlignment="Center" />
                    <TextBlock Text="macro" FontSize="14" FontWeight="Bold"
                               Foreground="#F2F3F5" Margin="6,0,14,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnNew" Style="{StaticResource Btn.Tool}"
                            Content="New" ToolTip="Start a new macro" />
                    <Button x:Name="BtnOpen" Style="{StaticResource Btn.Tool}"
                            Content="Open" ToolTip="Open a saved macro" Margin="2,0,0,0" />
                    <Button x:Name="BtnSave" Style="{StaticResource Btn.Tool}"
                            Content="Save" ToolTip="Save the macro (Ctrl+S)" Margin="2,0,0,0" />
                    <Button x:Name="BtnSaveAs" Style="{StaticResource Btn.Tool}"
                            Content="Save As" ToolTip="Save the macro to a new file"
                            Margin="2,0,8,0" />
                    <Button x:Name="BtnRun" Style="{StaticResource Btn.Run}"
                            Content="Run" ToolTip="Run the workflow" Margin="4,0,3,0" />
                    <ToggleButton x:Name="BtnPause" Style="{StaticResource Btn.Pause}"
                            Content="Pause" ToolTip="Pause / resume the run" Margin="0,0,3,0" />
                    <Button x:Name="BtnStop" Style="{StaticResource Btn.Stop}"
                            Content="Stop" ToolTip="Stop the running workflow" />
                    <Button x:Name="BtnCaptureScreen" Style="{StaticResource Btn.Tool}"
                            Content="📷 Mở giao diện chụp màn hình"
                            ToolTip="Chụp màn hình tab giả lập đang chọn và mở giao diện chụp màn hình"
                            Margin="6,0,0,0" Padding="8,3,8,3" FontWeight="SemiBold" />
                    <Button x:Name="BtnAttachedFiles" Style="{StaticResource Btn.Tool}"
                            Content="📄 Tệp TXT..."
                            ToolTip="Quản lý các tệp .txt đính kèm cho macro này"
                            Margin="4,0,0,0" Padding="8,3,8,3" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnEmulator" Style="{StaticResource Btn.Tool}"
                            Margin="2,0,0,0" ToolTip="Cấu hình trình giả lập Android" />
                    <Button x:Name="BtnLeftPanel" Style="{StaticResource Btn.Tool}"
                            Margin="2,0,0,0" ToolTip="Show / hide the action library" />
                    <Button x:Name="BtnRightPanel" Style="{StaticResource Btn.Tool}"
                            Margin="2,0,0,0" ToolTip="Show / hide the properties panel" />
                    <Button x:Name="BtnOutput" Style="{StaticResource Btn.Tool}"
                            Margin="2,0,0,0" Content="Log" ToolTip="Show / hide the output panel" />
                    <Button x:Name="BtnSettings" Style="{StaticResource Btn.Tool}"
                            Margin="2,0,0,0" Content="Settings"
                            ToolTip="Workflow settings (repeat, delays, failsafe)" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- ================= EMULATOR WARNING BANNER ================= -->
        <Border x:Name="EmulatorWarningBanner" DockPanel.Dock="Top"
                Background="#302316" BorderBrush="#D69A3A" BorderThickness="0,0,0,1"
                Padding="10,4" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnFixEmulator" DockPanel.Dock="Right"
                        Content="Cấu hình ngay" Style="{StaticResource Btn.Tool}"
                        FontSize="11" Padding="8,2,8,2" Margin="8,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠ " Foreground="#F0C06E" FontSize="11.5" FontWeight="Bold" />
                    <TextBlock x:Name="EmulatorWarningText"
                               Text="Chưa cấu hình trình giả lập Android (LDPlayer). Vui lòng thiết lập để chạy macro."
                               Foreground="#F0C06E" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= OUTPUT / LOG PANEL ================= -->
        <Border x:Name="OutputBorder" DockPanel.Dock="Bottom" Height="110"
                Background="{StaticResource Brush.BgPanel}"
                BorderBrush="#2F3034" BorderThickness="0,1,0,1">
            <ContentControl x:Name="OutputHost" />
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.BgPanel}"
                BorderBrush="#2F3034" BorderThickness="0,1,0,0" Height="24">
            <DockPanel LastChildFill="True" Margin="10,0,10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="7" Height="7"
                             Fill="{StaticResource Brush.Muted}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="StateText" Text="Ready" FontSize="11"
                               Foreground="{StaticResource Brush.Muted}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="CurrentStepText" Margin="14,0,0,0" FontSize="11"
                           Foreground="{StaticResource Brush.Amber}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LogText" Margin="14,0,14,0" FontSize="11"
                           Foreground="#77A9E8" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MouseText" Foreground="{StaticResource Brush.Muted}"
                               VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                               Text="Mouse: 0, 0" />
                    <TextBlock x:Name="FileText" Foreground="{StaticResource Brush.Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="11" MaxWidth="380" Text="Unsaved macro" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- ================= 3-PANEL WORKSPACE ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLibrary" Width="210" MinWidth="175" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition x:Name="ColProperties" Width="325" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="LibraryHost" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowEmulatorTabs" Height="140" MinHeight="75" MaxHeight="300" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- ================= LDPLAYER TAB LIST ================= -->
                <ContentControl x:Name="EmulatorTabsHost" Grid.Row="0" />

                <!-- Splitter between Tab List and Workflow Editor -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              Background="#23252A" Cursor="SizeNS" />

                <!-- ================= MACRO ACTIONS LIST ================= -->
                <ContentControl x:Name="EditorHost" Grid.Row="2" />
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
            <ContentControl x:Name="PropertiesHost" Grid.Column="4" />
        </Grid>
    </DockPanel>
</Window>
